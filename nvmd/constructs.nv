package nvmd

// The lines of a .nvmd body that are Novus and not Markdown, alone on their line: template blocks,
// <?nv ?> code, component tags and HTML blocks with handlers.

final BLOCK_OPENERS = ["{#", "{:", "{/", "{@html "]

// The last line of the construct that starts at line `index`; before `index` when the line is Markdown.
method constructEnd(array<string> lines, integer index, string file): integer {
    var trimmed = lines[index].trim()
    if (trimmed.startsWith(HEADER_OPENER)) {
        return codeEnd(lines, index, file)
    }
    if (isBlockLine(trimmed)) {
        return index
    }
    if (isComponentTag(trimmed)) {
        return tagEnd(lines, index, file)
    }
    return handlerBlockEnd(lines, index)
}

// {#if c}, {:else}, {/for}, {@html e}: the whole line is one brace group.
method isBlockLine(string trimmed): bool {
    if (trimmed.endsWith("}") == false) {
        return false
    }
    for (opener in BLOCK_OPENERS) {
        if (trimmed.startsWith(opener)) {
            return true
        }
    }
    return false
}

// <Name or </Name: a tag whose name starts with an upper-case letter.
method isComponentTag(string trimmed): bool {
    var name = 1
    if (trimmed.startsWith("</")) {
        name = 2
    }
    if (trimmed.length() <= name || trimmed.charAt(0) != "<") {
        return false
    }
    var first = trimmed.charAt(name)
    return first >= "A" && first <= "Z"
}

// The line that holds the `>` closing the tag that starts at line `from`; a tag may span lines.
// Nothing but blanks may follow it: a component stands on its own line.
method tagEnd(array<string> lines, integer from, string file): integer {
    var quote = ""
    var depth = 0
    var index = from
    while (index < lines.length()) {
        var line = lines[index]
        var column = 0
        if (index == from) {
            column = line.indexOf("<") + 1
        }
        while (column < line.length()) {
            var c = line.charAt(column)
            column = column + 1
            if (quote != "") {
                if (c == quote) {
                    quote = ""
                }
                continue
            }
            if (c == QUOTE || c == "'") {
                quote = c
                continue
            }
            depth = depth + braceDelta(c)
            if (c == ">" && depth <= 0) {
                return endOfTag(lines, index, column, file)
            }
        }
        index = index + 1
    }
    fail(file, from, "unclosed component tag (missing >)")
    return from
}

method braceDelta(string c): integer {
    if (c == "{") {
        return 1
    }
    if (c == "}") {
        return 0 - 1
    }
    return 0
}

method endOfTag(array<string> lines, integer index, integer column, string file): integer {
    var rest = lines[index].substring(column, lines[index].length())
    if (isBlank(rest) == false) {
        fail(file, index, "a component tag stands on its own line (found '" + rest.trim() + "' after it)")
    }
    return index
}
